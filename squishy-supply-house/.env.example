# ---------------------------------------------------------------------------
# Squishy Supply House by Clujkeebs
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Railway injects this automatically when a Postgres service is attached.
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Public origin, no trailing slash. Used for canonical URLs, sitemap, OG tags
# and payment redirect URLs.
NEXT_PUBLIC_SITE_URL="https://squishysupplyhouse.com"

# --- Security --------------------------------------------------------------
# Signs the admin session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=""

# Bearer token for the admin HTTP API and the MCP server.
# Generate: openssl rand -hex 24
ADMIN_API_TOKEN=""

# One-time token required to create the very first admin account at /admin/setup.
# Generate: openssl rand -hex 16
ADMIN_SETUP_TOKEN=""

# --- Shipping --------------------------------------------------------------
# Shipping is free, so both are 0. Set SHIPPING_FLAT_CENTS to e.g. 599 to
# charge $5.99, and FREE_SHIPPING_THRESHOLD_CENTS to waive it above a subtotal.
SHIPPING_FLAT_CENTS="0"
FREE_SHIPPING_THRESHOLD_CENTS="0"

# --- Payments --------------------------------------------------------------
# Which adapter handles checkout: "stripe" or "paypal". No code change to switch.
PAYMENT_PROVIDER="stripe"

# Stripe (test keys start with sk_test_ / whsec_)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# --- Email -----------------------------------------------------------------
# Resend. Without a key the app logs emails to the console instead of sending.
RESEND_API_KEY=""
# Must be a domain verified in Resend. onboarding@resend.dev works for testing
# but only delivers to the Resend account owner.
EMAIL_FROM="Squishy Supply House <orders@squishysupplyhouse.com>"
# Where new-order notifications go.
OWNER_EMAIL="clujkeebs@gmail.com"

# --- Images ----------------------------------------------------------------
# Extra CDN hostnames allowed through the image optimizer, comma separated.
# Common AliExpress and Cloudinary hosts are already allowed by default.
IMAGE_HOSTS=""

# --- Analytics (optional) --------------------------------------------------
# Off by default, which is why the site needs no cookie banner. Umami is
# cookie-free and GDPR-friendly.
NEXT_PUBLIC_ANALYTICS_ENABLED="false"
NEXT_PUBLIC_ANALYTICS_SRC="https://analytics.example.com/script.js"
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=""
