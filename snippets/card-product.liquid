{%- comment -%} Usage: render 'card-product', product: product {%- endcomment -%}

<article class="product-card">
  <a href="{{ product.url }}" class="product-card__image" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}
      <img
        src="{{ product.featured_image | image_url: width: 600 }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
        width="600"
      >
    {%- else -%}
      <div style="width:100%;height:100%;background:var(--bg-3);display:flex;align-items:center;justify-content:center;">
        <svg width="48" height="48" fill="none" stroke="var(--border)" stroke-width="1.5" viewBox="0 0 24 24">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <path d="M21 15l-5-5L5 21"/>
        </svg>
      </div>
    {%- endif -%}
    {%- if product.compare_at_price > product.price -%}
      <span class="product-card__badge">Sale</span>
    {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
      <span class="product-card__badge">New</span>
    {%- elsif product.tags contains 'limited' or product.tags contains 'Limited' -%}
      <span class="product-card__badge">Limited</span>
    {%- endif -%}
  </a>

  <div class="product-card__info">
    {%- if product.collections.first -%}
      <p class="product-card__collection">{{ product.collections.first.title }}</p>
    {%- endif -%}
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    <p class="product-card__price">
      {%- if product.compare_at_price > product.price -%}
        <s>{{ product.compare_at_price | money }}</s>
      {%- endif -%}
      {{ product.price | money }}
    </p>
    <a href="{{ product.url }}" class="product-card__cta">
      {%- if product.available -%}View Work{%- else -%}Sold Out{%- endif -%}
    </a>
  </div>
</article>
